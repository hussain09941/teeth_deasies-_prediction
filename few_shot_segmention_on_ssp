        "        figsize=(11, 5.5)\n",
        "    )\n",
        "\n",
        "    axes[0].imshow(segmented_image)\n",
        "    axes[0].set_title(\n",
        "        f\"Final Segmentation Overlay\\n\"\n",
        "        f\"mIoU = {miou * 100:.2f}%\"\n",
