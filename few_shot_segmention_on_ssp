        "        \"Green = TP | Red = FP | Blue = FN\"\n",
        "    )\n",
        "    axes[1].axis(\"off\")\n",
        "\n",
        "    fig.suptitle(\n",
        "        f\"DIAGNOSTICS | {VOC_CLASSES[class_id]}\",\n",
        "        fontsize=16\n",
        "    )\n",
        "    fig.tight_layout()\n",
        "\n",
        "    error_filename = f\"{save_prefix}_overlay_error.png\"\n",
        "\n",
        "    fig.savefig(\n",
        "        error_filename,\n",
        "        dpi=200,\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "    plt.show()\n",
        "    plt.close(fig)\n",
        "\n",
        "    print(\"\\n\")\n",
        "    print(\"=\" * 70)\n",
        "    print(\"VISUALIZATION FILES SAVED\")\n",
        "    print(\"=\" * 70)\n",
        "    print(\"1.\", support_filename)\n",
