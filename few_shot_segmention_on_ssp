        "# ============================================================\n",
        "# 34. SAME-IMAGE DIAGNOSTIC\n",
        "# ============================================================\n",
        "\n",
        "def create_same_image_episode(class_id):\n",
        "    samples = class_images[class_id]\n",
        "\n",
        "    if len(samples) == 0:\n",
        "        return None\n",
        "\n",
        "    for _ in range(20):\n",
        "        image_path, mask_path = random.choice(samples)\n",
        "        image_np, tensor = load_image(image_path)\n",
        "        mask = load_binary_mask(mask_path, class_id)\n",
        "\n",
        "        if int(mask.sum()) > 0:\n",
        "            return {\n",
        "                \"image\": image_np,\n",
        "                \"tensor\": tensor,\n",
        "                \"mask\": mask,\n",
        "                \"class_id\": class_id,\n",
        "                \"image_path\": image_path\n",
        "            }\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def same_image_diagnostic(model, class_id):\n",
        "    episode = create_same_image_episode(class_id)\n",
        "\n",
        "    if episode is None:\n",
        "        print(\"Could not create same-image episode.\")\n",
        "        return None\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    with torch.no_grad():\n",
        "        feature = extract_feature(model, episode[\"tensor\"])\n",
        "\n",
        "        mask_tensor = torch.from_numpy(\n",
        "            episode[\"mask\"]\n",
        "        ).float().to(device)\n",
        "\n",
        "        fg_proto, bg_proto = calculate_prototypes(\n",
        "            feature,\n",
        "            mask_tensor\n",
        "        )\n",
        "\n",
        "        # Initial support-prototype matching\n",
        "        initial_logits = calculate_fg_bg_logits(\n",
        "            feature,\n",
        "            fg_proto,\n",
        "            bg_proto\n",
        "        )\n",
        "\n",
        "        # Rough probability: BEFORE SSP refinement\n",
        "        rough_probability = torch.sigmoid(initial_logits)\n",
        "        rough_probability = F.interpolate(\n",
        "            rough_probability.unsqueeze(0).unsqueeze(0),\n",
        "            size=(IMAGE_SIZE, IMAGE_SIZE),\n",
        "            mode=\"bilinear\",\n",
        "            align_corners=False\n",
        "        ).squeeze().cpu().numpy()\n",
        "\n",
        "        # SSP refinement\n",
        "        final_logits = self_support_refinement(\n",
        "            feature,\n",
        "            fg_proto,\n",
        "            bg_proto,\n",
        "            initial_logits\n",
        "        )\n",
        "\n",
        "        # Final probability: AFTER SSP refinement\n",
        "        final_probability = torch.sigmoid(final_logits)\n",
        "        final_probability = F.interpolate(\n",
        "            final_probability.unsqueeze(0).unsqueeze(0),\n",
        "            size=(IMAGE_SIZE, IMAGE_SIZE),\n",
        "            mode=\"bilinear\",\n",
        "            align_corners=False\n",
        "        ).squeeze().cpu().numpy()\n",
        "\n",
        "        final_prediction = (\n",
        "            final_probability >= 0.5\n",
        "        ).astype(np.uint8)\n",
        "\n",
        "        miou, fgiou, bgiou = calculate_metrics(\n",
        "            final_prediction,\n",
        "            episode[\"mask\"]\n",
        "        )\n",
        "\n",
        "    return {\n",
        "        \"image\": episode[\"image\"],\n",
        "        \"ground_truth\": episode[\"mask\"],\n",
        "        \"rough_probability\": rough_probability,\n",
        "        \"final_probability\": final_probability,\n",
        "        \"prediction\": final_prediction,\n",
        "        \"mIoU\": miou,\n",
        "        \"FGIoU\": fgiou,\n",
        "        \"BGIoU\": bgiou,\n",
        "        \"class_id\": class_id,\n",
        "        \"image_path\": episode[\"image_path\"]\n",
        "    }\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 35. RUN SAME IMAGE DIAGNOSTIC\n",
        "# ============================================================\n",
        "\n",
        "print(\"\\n\")\n",
        "print(\"=\" * 80)\n",
        "print(\"SAME-IMAGE DIAGNOSTIC\")\n",
        "print(\"=\" * 80)\n",
        "\n",
        "diagnostic_model = all_trained_models[1]\n",
        "\n",
        "# Fold 1 unseen classes are [1, 2, 3, 4, 5].\n",
        "# Change this value if you want another unseen class.\n",
        "diagnostic_class = 1\n",
        "\n",
        "diagnostic_result = same_image_diagnostic(\n",
        "    diagnostic_model,\n",
        "    diagnostic_class\n",
        ")\n",
        "\n",
        "if diagnostic_result is not None:\n",
        "    print(\n",
        "        \"\\nDiagnostic class:\",\n",
        "        VOC_CLASSES[diagnostic_result[\"class_id\"]]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        \"Image:\",\n",
        "        diagnostic_result[\"image_path\"]\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Same-image mIoU : \"\n",
        "        f\"{diagnostic_result['mIoU'] * 100:.2f}%\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Same-image FGIoU: \"\n",
        "        f\"{diagnostic_result['FGIoU'] * 100:.2f}%\"\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"Same-image BGIoU: \"\n",
        "        f\"{diagnostic_result['BGIoU'] * 100:.2f}%\"\n",
        "    )\n",
        "\n",
